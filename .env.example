# Keep OPENAI_API_KEY server-only. Never prefix it with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Default: no network calls and no API credits. "replay" is an alias for the mock demo.
VITE_AGENT_MODE=mock

# Optional legacy switch; VITE_AGENT_MODE takes priority.
# VITE_AGENT_PROVIDER=mock
# To activate server-side live structured decisions instead:
# VITE_AGENT_MODE=live
