# Optional server-only key for the Codex SDK. Never prefix it with VITE_.
# If omitted, the local Codex CLI authentication is used when available.
CODEX_API_KEY=

# Default: no model calls. Replay never calls Codex or the network.
VITE_AGENT_MODE=mock

# To activate server-side Codex structured decisions instead:
# VITE_AGENT_MODE=live
