# Server-only OpenAI API key for live planning. Never prefix it with VITE_.
# Add this in Vercel Project Settings → Environment Variables; do not commit it.
OPENAI_API_KEY=

# Optional live model. gpt-5-mini is the bounded planner default.
OPENAI_MODEL=gpt-5-mini

# Default: no model calls. Replay never calls OpenAI or the network.
VITE_AGENT_MODE=mock

# To activate server-side OpenAI structured decisions instead:
# VITE_AGENT_MODE=live
